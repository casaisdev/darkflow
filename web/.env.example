# Which stream source the client uses. "synthetic" (default) generates fake but
# plausible L1 traffic in the browser; "replay" plays a recording of mainnet
# from public/replay/ (see scripts/capture-replay.mjs); "sse" reads the live
# feed — served by this site's own route handlers (see the end of this file)
# or by any endpoint speaking the contract in types/stream.ts.
#
# Read as a literal `process.env.NEXT_PUBLIC_STREAM_SOURCE` so Next inlines it
# at build time and the bundler can drop the branch not taken. It is a BUILD
# time value, not a runtime one: changing it needs a rebuild.
NEXT_PUBLIC_STREAM_SOURCE=synthetic

# The live feed's SSE endpoint. Only used when the source is "sse". In
# production this is the site's own route, "/api/stream", same origin. A feed
# on another origin works too, but then it has to allow this origin (CORS);
# the fake ingest in scripts/ does, for local work.
NEXT_PUBLIC_INGEST_URL=

# Recording to replay. Used when the source is "replay" — and, on an "sse"
# build, as the automatic stand-in when the live feed has been gone for a
# minute: the page switches to the recording, says "recorded · live feed
# lost", and offers a way back. Leave it empty on a live build and no
# fallback exists — which the page then does not promise. A path under
# public/, as the browser will fetch it. `pnpm capture` prints the right line.
NEXT_PUBLIC_REPLAY_URL=

# Optional scenario for the synthetic source: "mev" draws ghost gas from a
# heavier distribution, so the by-gas ratio diverges from the by-transaction
# one the way it does on mainnet. Leave unset for the calibration reference.
NEXT_PUBLIC_GHOST_GAS_BIAS=

# Optional, synthetic source only: re-issue every Nth block a moment after it
# lands, at the same height with different hashes — a one-block reorg — so the
# client's replacement path can be watched. Unset or 0 never does.
NEXT_PUBLIC_SYNTHETIC_REORG_EVERY=

# ── Deploying: the four that matter ─────────────────────────────────────────
# One Vercel project, Root Directory "web", these four in its environment.
# The live feed is served by this site's own route handlers
# (app/api/[endpoint]: stream, state, health), which run the ingest core from ../ingest
# inside the site's functions — so the ingest's settings are this project's
# server-side variables too. Nothing else is needed.
#
#   NEXT_PUBLIC_STREAM_SOURCE=sse
#   NEXT_PUBLIC_INGEST_URL=/api/stream
#   NEXT_PUBLIC_REPLAY_URL=replay/mainnet-2026-09-03.json   (or empty: no fallback)
#   UPSTREAM_WS_URL=wss://ethereum-rpc.publicnode.com

# Upstream WebSocket endpoints for the ingest, comma-separated, tried in order.
# Server-side only, never NEXT_PUBLIC_. Must deliver full pending transactions,
# newHeads and eth_getBlockReceipts: PublicNode does, free and without a key;
# dRPC serves heads and receipts but only hashes for pending, so it is a
# partial fallback. Read the first time a page opens /api/stream.
UPSTREAM_WS_URL=

# ── The ingest's tunables, all optional, with their defaults ─────────────────
# Sizes and delays, not places. Server-side.
#BLOCKS_WS_URL=            a separate connection for heads and receipts (unset: the pending one carries them)
#IDLE_STOP_MS=60000        drop the upstream this long after the last page leaves; 0 = always on
#STREAM_MAX_MS=290000      close a stream cleanly after this long so the page reconnects
#                          (derived from the route's maxDuration when unset; 0 = never)
#POOL_TTL_MS=300000        how long an announced hash is remembered
#POOL_MAX=200000           hard cap on that memory; logged when it binds
#BATCH_INTERVAL_MS=100     txs frames leave this often
#MAX_BATCH_TXS=2000        most transactions in one frame; oldest dropped and counted past it
#RECEIPTS_DELAY_MS=1500    wait after a head before asking for its receipts
#RECEIPTS_ATTEMPTS=3       attempts, each waiting twice as long as the last
#BACKFILL_MAX=10           blocks filled in from parent hashes behind a head after a gap
#RECONNECT_MIN_MS=1000     first reconnect wait; doubles up to 30 s with jitter
#KEEPALIVE_MS=15000        SSE comment interval
#CLIENT_STALL_MS=10000     a page back-pressured this long is closed
#MAX_CLIENTS=500           beyond this, 503 with Retry-After
#MAX_CLIENTS_PER_IP=8      streams one address may hold; beyond it, 429 with Retry-After
#REPLAY_MS=60000           how far back Last-Event-ID can reach on a reconnect
#HEAD_STALE_MS=36000       /api/health is 503 after this long without a head
#PENDING_STALE_MS=30000    /api/health is 503 after this long without a pending transaction
